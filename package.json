{
  "name": "commander-clash",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:cards": "tsx tools/build-cards.ts",
    "test": "npm run test -w @cc/engine",
    "typecheck": "tsc -p packages/engine && tsc -p apps/web",
    "dev": "npm run dev -w @cc/web",
    "simulate": "tsx tools/simulate.ts",
    "coverage": "tsx tools/coverage.ts",
    "blockers": "tsx tools/blockers.ts",
    "e2e": "npm run e2e -w @cc/web",
    "e2e:cards": "tsx tools/e2e-cards.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  }
}
